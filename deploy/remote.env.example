# Runtime config for `appknox-mcp --http` (remote, multi-user, OAuth).
# Copy to deploy/remote.env (gitignored) or set as container/k8s env vars.
# Nothing here is secret: users' OAuth tokens arrive with each request.

# Appknox API host (mycroft) this server calls on the user's behalf.
APPKNOX_API_BASE_URL=https://api.appknox.com
# Public base URL clients use to reach THIS server (no trailing /mcp).
# Advertised in RFC 9728 metadata; also the only accepted Host header.
APPKNOX_MCP_PUBLIC_URL=https://mcp.appknox.com
# OAuth issuer clients are sent to. Defaults to <API>/api/v2/oidc; set it when
# the browser-facing API host differs from the one this server calls.
# APPKNOX_OAUTH_ISSUER=https://api.appknox.com/api/v2/oidc
# Extra Host headers to accept (comma-separated), e.g. an internal LB name.
# APPKNOX_MCP_ALLOWED_HOSTS=
# Stateless HTTP lets any replica serve any request (default true).
# APPKNOX_MCP_STATELESS=true
